#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

for command in node npm python3 jq; do
  command -v "$command" >/dev/null || { echo "Required command not found: $command" >&2; exit 1; }
done

if command -v brew >/dev/null; then
  missing=()
  for formula in yt-dlp ffmpeg tmux; do
    command -v "$formula" >/dev/null || missing+=("$formula")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    brew install "${missing[@]}"
  fi
else
  for command in yt-dlp ffmpeg tmux; do
    command -v "$command" >/dev/null || { echo "Install $command and rerun this script." >&2; exit 1; }
  done
fi

npm_projects=(
  "$REPO_ROOT/config/global/extensions/bash-guard"
  "$REPO_ROOT/config/global/extensions/browser"
  "$REPO_ROOT/config/global/extensions/web-fetch"
  "$REPO_ROOT/config/projects/learn/extensions/visual-tools"
)

for project in "${npm_projects[@]}"; do
  if (cd "$project" && npm ls --omit=dev --depth=0 >/dev/null 2>&1); then
    echo "Reusing matching installed dependencies: $project"
  else
    echo "Installing missing locked dependencies: $project"
    (cd "$project" && npm ci)
  fi
done

pi_package="$(npm root -g)/@earendil-works/pi-coding-agent"
[[ -d "$pi_package" ]] || { echo "Installed Pi package not found at $pi_package" >&2; exit 1; }
visual_modules="$REPO_ROOT/config/projects/learn/extensions/visual-tools/node_modules/@earendil-works"
mkdir -p "$visual_modules"
mkdir -p "$REPO_ROOT/.deploy-state"
visual_link="$visual_modules/pi-coding-agent"
if [[ -e "$visual_link" || -L "$visual_link" ]]; then
  if [[ ! -L "$visual_link" || "$(readlink "$visual_link")" != "$pi_package" ]]; then
    mv "$visual_link" "$REPO_ROOT/.deploy-state/pi-coding-agent-dependency-$RANDOM"
  fi
fi
[[ -L "$visual_link" ]] || ln -s "$pi_package" "$visual_link"

browser_dir="$REPO_ROOT/config/global/extensions/browser"
if (cd "$browser_dir" && node --input-type=module -e 'import { existsSync } from "node:fs"; import { chromium } from "playwright-core"; if (!existsSync(chromium.executablePath())) process.exit(1)') >/dev/null 2>&1; then
  echo "Reusing matching Playwright Chromium runtime"
else
  echo "Installing matching Playwright Chromium runtime"
  (cd "$browser_dir" && npx playwright-core install chromium)
fi

visual_dir="$REPO_ROOT/config/projects/learn/extensions/visual-tools"
if (cd "$visual_dir" && node --input-type=module -e 'import { existsSync } from "node:fs"; import puppeteer from "puppeteer"; const path = await puppeteer.executablePath(); if (!existsSync(path)) process.exit(1)') >/dev/null 2>&1; then
  echo "Reusing installed Puppeteer Chrome runtime"
else
  echo "Installing Puppeteer Chrome runtime"
  (cd "$visual_dir" && npx puppeteer browsers install chrome)
fi

pdf_skill="$REPO_ROOT/config/global/skills/pdf-reader"
[[ -x "$pdf_skill/.venv/bin/python" ]] || python3 -m venv "$pdf_skill/.venv"
if [[ "$("$pdf_skill/.venv/bin/python" -c 'import fitz; print(fitz.__version__)' 2>/dev/null || true)" == "1.27.2.2" ]]; then
  echo "Reusing PyMuPDF 1.27.2.2 virtual environment"
else
  "$pdf_skill/.venv/bin/python" -m pip install --disable-pip-version-check -r "$pdf_skill/requirements.txt"
fi

echo "Dependency installation complete."
