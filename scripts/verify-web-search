#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AUTH_PATH="$REPO_ROOT/config/global/extensions/web-search/auth.json"

has_file_key=0
if [[ -f "$AUTH_PATH" ]] && jq -e '.brave_search_api_key | type == "string" and length > 0' "$AUTH_PATH" >/dev/null; then
	has_file_key=1
fi

if [[ -z "${BRAVE_SEARCH_API_KEY:-}" && $has_file_key -eq 0 ]]; then
	echo "Brave Search key is not configured." >&2
	echo "Populate brave_search_api_key in: $AUTH_PATH" >&2
	echo "Alternatively export BRAVE_SEARCH_API_KEY for this process." >&2
	exit 1
fi

output="$(mktemp "${TMPDIR:-/tmp}/pi-brave-search.XXXXXX")"
trap 'rm -f "$output"' EXIT

(
	cd "$HOME"
	PI_OFFLINE=1 pi --no-session --mode json --thinking off --tools web_search -p \
		'Call web_search exactly once with query "Brave Search API documentation", site "brave.com", and count 3.'
) >"$output" 2>&1

grep -Fq '"toolName":"web_search"' "$output" || {
	tail -n 40 "$output" >&2
	echo "web_search was not called." >&2
	exit 1
}
grep -Fq '"provider":"brave"' "$output" || {
	tail -n 40 "$output" >&2
	echo "Brave Search did not return a successful tool result." >&2
	exit 1
}
grep -Fq 'https://' "$output" || {
	tail -n 40 "$output" >&2
	echo "Brave Search returned no URL." >&2
	exit 1
}

echo "PASS: Brave web_search returned live results."
