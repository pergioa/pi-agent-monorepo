{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Async Pi subagents with managed headless RPC processes and an interactive tmux fallback",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.70.0 <1",
    "@mariozechner/pi-tui": ">=0.70.0 <1",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.0",
    "@mariozechner/pi-tui": "^0.70.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
